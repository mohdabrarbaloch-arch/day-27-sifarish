# Copy to .env and fill in a real secret.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=replace-me-with-a-generated-secret-at-least-32-chars
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sifarish.db

# Comma-separated. Set to your deployed origin in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Engine tuning
SHRINKAGE_LAMBDA=5.0
NEIGHBOUR_K=40
DEFAULT_RECOMMENDATION_COUNT=12
